n    except ValueError:\n        return None\ndef fmt(x):\n    return str(int(x)) if x == int(x) else repr(x)\nvals = [fl(r['value']) for r in rows]\nnums = sorted(v for v in vals if v is not None)\nmn = nums[0]\nmx = nums[-1]\nb = 5\nw = (mx - mn) / b\ndef wlab(v):\n    i = min(max(math.floor((v - mn) / w), 0), b - 1)\n    lo = mn + i * w\n    hi = mx if i == b - 1 else mn + (i + 1) * w\n    return '[%s,%s%s' % (fmt(lo), fmt(hi), ']' if i == b - 1 else ')')\ndef pct(s, p):\n    idx = p / 100 * (len(s) - 1)\n    lo = math.floor(idx)\n    hi = math.ceil(idx)\n    return s[lo] + (idx - lo) * (s[hi] - s[lo])\nq = 4\nbd = [pct(nums, j * 100 / q) for j in range(q + 1)]\ndef qlab(v):\n    i = max(k for k in range(q) if v >= bd[k])\n    hi = mx if i == q - 1 else bd[i + 1]\n    return '[%s,%s%s' % (fmt(bd[i]), fmt(hi), ']' if i == q - 1 else ')')\nprint(json.dumps({'a1': 0, 'a2': wlab(0), 'a3': wlab(10), 'a4': wlab(5), 'a5': qlab(0), 'a6': qlab(5), 'a7': qlab(7.5), 'a8': '', 'a9': ''}))\n"},"note":null},{"key":"compare-diff","object":"O31","blocks":["R2.S19.P1","R2.S19.P2","R2.S20.P1","R2.S21.P1","R2.S22.P1","R2.S22.P4","R2.S23.P1"],"uses":[],"direction":"holds","input":{"args":["compare","--left","left.csv","--right","right.csv","--key","id","--output","diff.json"],"files":[{"path":"left.csv","content":"id,name\n1,a\n2,b\n3,c\n"},{"path":"right.csv","content":"id,name\n2,b\n3,z\n4,d\n"}]},"assertions":[{"id":"a1","role":"business","target":{"kind":"exit_code","path":null,"line":null,"pointer":null,"column":null},"expect_json":"0","tolerance":null,"source":{"kind":"derived","block":"R2.S19.P1","quote":null}},{"id":"a2","role":"business","target":{"kind":"json","path":"diff.json","line":null,"pointer":"/summary/added","column":null},"expect_json":"1","tolerance":null,"source":{"kind":"derived","block":"R2.S21.P1","quote":null}},{"id":"a3","role":"business","target":{"kind":"json","path":"diff.json","line":null,"pointer":"/summary/removed","column":null},"expect_json":"1","t