rt csv, json, math\nrows = list(csv.DictReader(open('data.csv', newline='')))\ndef fl(s):\n    try:\n        return float(s)\n    except ValueError:\n        return None\nvals = [fl(r['value']) for r in rows]\nnums = sorted(v for v in vals if v is not None)\ndef pct(s, p):\n    idx = p / 100 * (len(s) - 1)\n    lo = math.floor(idx)\n    hi = math.ceil(idx)\n    return s[lo] + (idx - lo) * (s[hi] - s[lo])\nq1 = pct(nums, 25)\nq3 = pct(nums, 75)\niqr = q3 - q1\niq = ['1' if v is not None and (v < q1 - 1.5 * iqr or v > q3 + 1.5 * iqr) else '0' for v in vals]\nn = len(nums)\nm = sum(nums) / n\nsd = math.sqrt(sum((x - m) ** 2 for x in nums) / n)\nzz = ['1' if v is not None and sd != 0 and abs(v - m) / sd > 2 else '0' for v in vals]\nmed = pct(nums, 50)\nmad = pct(sorted(abs(x - med) for x in nums), 50)\ndef mdf(v):\n    if v is None:\n        return '0'\n    if mad == 0:\n        return '1' if v != med else '0'\n    return '1' if abs(0.6745 * (v - med) / mad) > 3.5 else '0'\nmd = [mdf(v) for v in vals]\nprint(json.dumps({'a1': 0, 'a2': iq[5], 'a3': iq[0], 'a4': iq[6], 'a5': md[7], 'a6': zz[5], 'a7': md[5], 'a8': zz[0]}))\n"},"note":null},{"key":"bin-width-quantile","object":"O30","blocks":["R2.S17.P1","R2.S17.P5","R2.S17.P7","R2.S17.P8"],"uses":[],"direction":"holds","input":{"args":["transform","--input","data.csv","--recipe","recipe.json","--output","out.csv","--seed","1"],"files":[{"path":"data.csv","content":"id,value\n1,0\n2,5\n3,10\n4,\n5,7.5\n6,abc\n"},{"path":"recipe.json","content":"[{\"op\": \"bin\", \"column\": \"value\", \"method\": \"width\", \"bins\": 5, \"as\": \"w\"}, {\"op\": \"bin\", \"column\": \"value\", \"method\": \"quantile\", \"bins\": 4, \"as\": \"q\"}]\n"}]},"assertions":[{"id":"a1","role":"business","target":{"kind":"exit_code","path":null,"line":null,"pointer":null,"column":null},"expect_json":"0","tolerance":null,"source":{"kind":"derived","block":"R2.S17.P1","quote":null}},{"id":"a2","role":"business","target":{"kind":"csv_cell","path":"out.