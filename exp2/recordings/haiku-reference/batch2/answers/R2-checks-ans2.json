ne='')))\ndef fl(s):\n    try:\n        return float(s)\n    except ValueError:\n        return None\ndef fmt(x):\n    return str(int(x)) if x == int(x) else repr(x)\nvals = [fl(r['value']) for r in rows]\nnums = sorted(v for v in vals if v is not None)\nmn = nums[0]\nmx = nums[-1]\nb = 5\nw = (mx - mn) / b\ndef wlab(v):\n    i = min(max(math.floor((v - mn) / w), 0), b - 1)\n    lo = mn + i * w\n    hi = mx if i == b - 1 else mn + (i + 1) * w\n    return '[%s,%s%s' % (fmt(lo), fmt(hi), ']' if i == b - 1 else ')')\ndef pct(s, p):\n    idx = p / 100 * (len(s) - 1)\n    lo = math.floor(idx)\n    hi = math.ceil(idx)\n    return s[lo] + (idx - lo) * (s[hi] - s[lo])\nq = 4\nbd = [pct(nums, j * 100 / q) for j in range(q + 1)]\ndef qlab(v):\n    i = max(k for k in range(q) if v >= bd[k])\n    hi = mx if i == q - 1 else bd[i + 1]\n    return '[%s,%s%s' % (fmt(bd[i]), fmt(hi), ']' if i == q - 1 else ')')\nprint(json.dumps({'a1': 0, 'a2': wlab(0), 'a3': wlab(10), 'a4': wlab(5), 'a5': qlab(0), 'a6': qlab(5), 'a7': qlab(7.5), 'a8': '', 'a9': ''}))\n"},"note":null}],"remove":[],"retire_add":[],"retire_remove":[]}
