ived","block":"R4.S4.P6","quote":"`rows_checked` (data row count)"}},{"id":"v0","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/violations/0","column":null},"expect_json":"{\"column\":\"age\",\"row\":2,\"rule\":\"type\",\"value\":\"abc\",\"message\":\"expected int, got \\\"abc\\\"\"}","tolerance":null,"source":{"kind":"derived","block":"R4.S3.P1","quote":null}},{"id":"v1","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/violations/1","column":null},"expect_json":"{\"column\":\"age\",\"row\":3,\"rule\":\"required\",\"value\":null,\"message\":\"value is required\"}","tolerance":null,"source":{"kind":"derived","block":"R4.S3.P1","quote":null}},{"id":"v2","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/violations/2","column":null},"expect_json":"{\"column\":\"age\",\"row\":4,\"rule\":\"max\",\"value\":\"200\",\"message\":\"value 200 exceeds maximum 150\"}","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P4","quote":null}},{"id":"v3","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/violations/3","column":null},"expect_json":"{\"column\":\"email\",\"row\":5,\"rule\":\"pattern\",\"value\":\"nobody\",\"message\":\"value \\\"nobody\\\" does not match pattern ^[^@]+@[^@]+$\"}","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P4","quote":null}},{"id":"v4","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/violations/4","column":null},"expect_json":"{\"column\":\"email\",\"row\":null,\"rule\":\"unique\",\"value\":\"a@x.com\",\"message\":\"duplicate value \\\"a@x.com\\\" (first at row 1, repeated at row 4)\"}","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P4","quote":null}},{"id":"v5","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/violations/5","column":null},"expect_json":"{\"column\":\"status\",\"row\":3,\"rule\":\"enum\",\"value\":\"pending\",\"message\":\"value \\\"pending\\\" is not in allowed values [active, inactive]\"}","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P4","quote":null}}],"reference_script":{"language":"python","code":"import csv, json, re\nQ = chr(34)\nschema = json.load(open('schema.json'))\nrows = list(csv.reader(open('data.csv', newline='')))\nheader, data = rows[0], rows[1:]\ncols = schema['columns']\ndef parses(v, t):\n    if t == 'string':\n        return True\n    try:\n        if t == 'int':\n            int(v, 10)\n        else:\n            float(v)\n        return True\n    except ValueError:\n        return False\nviol = []\ndef add(c, row, rule, value, msg):\n    viol.append({'column': c, 'row': row, 'rule': rule, 'value': value, 'message': msg})\nfor ci, c in enumerate(header):\n    if c not in cols:\n        continue\n    s = cols[c]\n    t = s['type']\n    vals = [(i + 1, r[ci]) for i, r in enumerate(data)]\n    for row, v in vals:\n        if v != '' and not parses(v, t):\n            add(c, row, 'type', v, 'expected ' + t + ', got ' + Q + v + Q)\n    for row, v in vals:\n        if v == '' and s.get('required'):\n            add(c, row, 'required', None, 'value is required')\n    for row, v in vals:\n        if v != '' and t != 'string' and parses(v, t):\n            if 'min' in s and float(v) < s['min']:\n                add(c, row, 'min', v, 'value ' + v + ' is below minimum ' + str(s['min']))\n            if 'max' in s and float(v) > s['max']:\n                add(c, row, 'max', v, 'value ' + v + ' exceeds maximum ' + str(s['max']))\n    for row, v in vals:\n        if v != '' and t == 'string' and 'pattern' in s and not re.search(s['pattern'], v):\n            add(c, row, 'pattern', v, 'value ' + Q + v + Q + ' does not match pattern ' + s['pattern'])\n    for row, v in vals:\n        if v != '' and 'enum' in s and v not in s['enum']:\n            add(c, row, 'enum', v, 'value ' + Q + v + Q + ' is not in allowed values [' + ', '.join(s['enum']) + ']')\n    seen = {}\n    for row, v in vals:\n        if v == '' or not s.get('unique'):\n            continue\n        if v in seen:\n            add(c, None, 'unique', v, 'duplicate value ' + Q + v + Q + ' (first at row ' + str(seen[v]) + ', repeated at row ' + str(row) + ')')\n        else:\n            seen[v] = row\ntotal = len(viol)\nout = {'exit': 0, 'valid': total == 0, 'total': total, 'cols': sum(1 for c in header if c in cols), 'rows': len(data)}\nfor i, v in enumerate(viol):\n    out['v' + str(i)] = v\nprint(json.dumps(out))\n"},"note":"row is the 1-based data row index, header excluded (spec example only implies it); exit 0 assumed when violations are found, since R4.S6 lists no exit 1 for them; v4 row is null (unique rule)."},{"key":"validate_clean_file","object":"O36","blocks":["R4.S1.P1","R4.S4.P6","R4.S3.P1"],"uses":[],"direction":"holds","input":{"args":["validate","--input","data.csv","--schema","schema.json","--output","report.json"],"files":[{"path":"data.csv","content":"age,email,status\n30,a@x.com,active\n40,b@y.com,inactive\n"},{"path":"schema.json","content":"{\"columns\": {\"age\": {\"type\": \"int\", \"min\": 0, \"max\": 150, \"required\": true}, \"email\": {\"type\": \"string\", \"pattern\": \"^[^@]+@[^@]+$\", \"unique\": true}, \"status\": {\"type\": \"string\", \"enum\": [\"active\", \"inactive\"]}}, \"strict\": false}\n"}]},"assertions":[{"id":"exit","role":"business","target":{"kind":"exit_code","path":null,"line":null,"pointer":null,"column":null},"expect_json":"0","tolerance":null,"source":{"kind":"derived","block":"R4.S6.P1","quote":null}},{"id":"valid","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/valid","column":null},"expect_json":"true","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P6","quote":"`valid` = true iff total_violations is 0."}},{"id":"total","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/summary/total_violations","column":null},"expect_json":"0","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P6","quote":"Summary: `total_violations` (count)"}}],"reference_script":{"language":"python","code":"import csv, json, re\nrows = list(csv.DictReader(open('data.csv', newline='')))\nbad = 0\nfor r in rows:\n    if not (r['age'].isdigit() and 0 <= int(r['age']) <= 150):\n        bad += 1\n    if not re.search(r'^[^@]+@[^@]+$', r['email']):\n        bad += 1\n    if r['status'] not in ('active', 'inactive'):\n        bad += 1\nbad += len(rows) - len(set(r['email'] for r in rows))\nprint(json.dumps({'exit': 0, 'valid': bad == 0, 'total': bad}))\n"},"note":"no-false-positive case: clean file must give valid true and zero violations."},{"key":"validate_strict_missing_column","object":"O36","blocks":["R4.S2.P4","R4.S3.P2","R4.S4.P3","R4.S4.P4","R4.S4.P5","R4.S5.P1"],"uses":[],"direction":"holds","input":{"args":["validate","--input","data.csv","--schema","schema.json","--output","report.json"],"files":[{"path":"data.csv","content":"age,nickname\n30,Al\n"},{"path":"schema.json","content":"{\"columns\": {\"age\": {\"type\": \"int\"}, \"email\": {\"type\": \"string\"}}, \"strict\": true}\n"}]},"assertions":[{"id":"exit","role":"business","target":{"kind":"exit_code","path":null,"line":null,"pointer":null,"column":null},"expect_json":"0","tolerance":null,"source":{"kind":"derived","block":"R4.S6.P1","quote":null}},{"id":"total","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/summary/total_violations","column":null},"expect_json":"2","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P6","quote":"Summary: `total_violations` (count)"}},{"id":"cols","role":"business","target":{"kind":"json","path":"report.json","line":null,"pointer":"/summary/columns_checked","column":null},"expect_json":"1","tolerance":null,"source":{"kind":"derived","block":"R4.S4.P6","quote":"`columns_checked` (schema columns present in CSV)"}},{"id":"v0","role":